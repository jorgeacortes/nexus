{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "DATA_DIR=./data-dev tsx scripts/migrate-databases.ts && DATA_DIR=./data-dev next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "DATA_DIR=./data tsx scripts/migrate-databases.ts && DATA_DIR=./data next start -p ${PORT:-3100}",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "pnpm check && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-databases.ts",
    "db:studio": "drizzle-kit studio",
    "docker:up": "bash scripts/docker-up.sh up -d --build",
    "docker:down": "bash scripts/docker-up.sh down",
    "docker:logs": "bash scripts/docker-up.sh logs -f --tail=100"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "radix-ui": "^1.6.2",
    "react": "^19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "typebox": "^1.3.34",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
