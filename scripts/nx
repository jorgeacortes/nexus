#!/usr/bin/env bash
# The `nx` command surface. Install it on PATH once:
#
#   ln -sf ~/ws/biznagatec-ws/nexus/scripts/nx ~/.local/bin/nx
#
# It only runs the HTTP client in src/cli/nx.ts, so it is safe from any cwd. The
# board URL is resolved inside the client: NEXUS_URL, then ~/.config/nexus/env,
# then a probe of the local ports (`nx doctor` shows what each candidate answered).
set -euo pipefail

# Follow the symlink so the wrapper works from wherever it was installed.
repo="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"

exec pnpm --dir "$repo" exec tsx src/cli/nx.ts "$@"
