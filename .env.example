# Copy to `.env` to override the Docker Compose defaults. Compose reads this
# file automatically; shell environment variables win over it.

# Host port that publishes the app. The container always listens on 3100.
HOST_PORT=3210

# Interface to bind the published port to (0.0.0.0 makes it reachable over the
# VPN/Tailscale; use 127.0.0.1 to keep it local).
BIND_ADDRESS=0.0.0.0

# Host Herdr config directory, mounted read-only at /herdr so the agent screens
# can read the live session.
HERDR_CONFIG_DIR=/home/you/.config/herdr

# Host UID/GID used to own the bind-mounted SQLite files. scripts/docker-up.sh
# fills these from `id -u`/`id -g`; set them only to force a value.
# DOCKER_UID=1000
# DOCKER_GID=1000
