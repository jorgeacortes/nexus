# Copy to `.env` to override the Docker Compose defaults. Compose reads this
# file automatically; shell environment variables win over it.

# Host port that publishes the app. The container always listens on 3100.
HOST_PORT=3210

# Interface to bind the published port to (0.0.0.0 makes it reachable over the
# VPN/Tailscale; use 127.0.0.1 to keep it local).
BIND_ADDRESS=0.0.0.0

# Host Herdr config directory, mounted read-only at /herdr so the agent screens
# can read the live session.
HERDR_CONFIG_DIR=/home/you/.config/herdr

# Host UID/GID used to own the bind-mounted SQLite files. scripts/docker-up.sh
# fills these from `id -u`/`id -g`; set them only to force a value.
# DOCKER_UID=1000
# DOCKER_GID=1000

# Daily ./data backup to the existing Cloudflare R2 bucket (`pnpm backup:data`,
# scripts/backup-data.sh). Objects go under the `nexus` prefix. Do not create a
# new bucket. Copy this block into .env.local and set the account and bucket to
# the same values the biznagatec-os backup already uses.
#
# Secrets — never commit these. The shell wrapper injects them with `fnox exec`
# when FNOX_AGE_KEY or FNOX_AGE_KEY_FILE is set; otherwise put them in .env.local:
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY
R2_ACCOUNT_ID=
R2_BUCKET=
R2_BACKUP_PREFIX=nexus
BACKUP_RETENTION_DAYS=30
# Optional. Defaults shown.
# R2_ENDPOINT=https://<accountid>.eu.r2.cloudflarestorage.com
# BACKUP_DATA_DIR=./data
# Crontab (03:10 daily). PATH must include node and fnox, and an age key must be
# set, or the wrapper cannot inject the two secret keys:
#   10 3 * * * /home/sandbox/ws/biznagatec-ws/nexus/scripts/backup-data.sh >> /home/sandbox/.logs/nexus-backup.log 2>&1

# Periodic jobs, read by the compose `jobs` service (scripts/jobs-tick.ts).
# Off by default so `docker compose up` does not dispatch a Herdr pane.
# Restart the jobs container after changing any of these.
# JOBS_ENABLED=0
# How many due jobs one tick may claim.
# JOB_CONCURRENCY=1
# Seconds between ticks. 60 sleeps to the next minute, then up to 5s of jitter.
# JOB_TICK_SECONDS=60
# Report due jobs and write nothing: no lease, no prompt, no last_tick_at.
# JOB_DRY_RUN=0
